# JARVIS OS environment template
# Copy to .env for local development. Never commit real credentials.

NODE_ENV=development
JARVIS_ENV=local
AWS_REGION=ap-south-1
JARVIS_EVENT_BUS_NAME=jarvis-os
JARVIS_TASK_TABLE_NAME=
JARVIS_WORKER_QUEUE_URL=
JARVIS_LOG_LEVEL=info
JARVIS_MODEL_PROVIDER=bedrock
JARVIS_MODEL_ID=
